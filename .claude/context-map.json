{
  "$comment": "Change-impact map for scripts/check-context.mjs. Each area lists the source globs it owns and the context files to re-check when they change. impact=high areas trigger the Stop-hook reminder; low areas are only reported. optional=true areas may match no file yet. mayBeAbsent lists generated, ignored or not-yet-created paths that docs may name. Update it in the same edit that adds, renames or removes a module (see CLAUDE.md, Engineering context maintenance).",
  "contextFiles": [
    "CLAUDE.md",
    ".claude/rules/*.md",
    ".claude/skills/*/SKILL.md",
    ".claude/agents/*.md",
    ".claude/context-map.json"
  ],
  "humanDocs": [
    "README.md",
    "DEPLOYMENT_CHECKLIST.md",
    "docs/*.md"
  ],
  "mayBeAbsent": [
    ".claude/agents",
    ".claude/_generated",
    ".git/claude-context-state.json",
    "admin-panel/.next",
    "storefront/.next",
    "web/public/_next",
    "web/public/storefront.html",
    "admin-panel/tsconfig.tsbuildinfo",
    ".env",
    "sessions",
    ".git/info/privacy-blocklist"
  ],
  "areas": [
    {
      "id": "money-paths",
      "impact": "high",
      "summary": "Wallet credit, top-ups, purchases, refunds, provider webhooks and recovery",
      "globs": [
        "services/hooshpay/**",
        "services/nowpayments/**",
        "services/payments/**",
        "services/pricing/**",
        "services/buyService/**",
        "services/walletCredit.js",
        "services/trxWalletScanner.js",
        "services/createTestService.js",
        "services/manualFulfillment.js",
        "paymentHandlers/**",
        "api/**",
        "handlers/reservedOrderCallbacks.js"
      ],
      "review": [
        "docs/payments.md",
        "docs/reserved-orders.md",
        ".claude/rules/money-paths.md",
        ".claude/skills/swift-audit/SKILL.md",
        ".claude/skills/swift-test/SKILL.md"
      ]
    },
    {
      "id": "persistence",
      "impact": "high",
      "summary": "Mongoose models, unique indexes, index migrations, Redis leases",
      "globs": [
        "models/**",
        "config/db.js",
        "config/mongoIndexMigration.js",
        "config/redisClient.js",
        "config/sessionStore.js",
        "services/jobLease.js",
        "services/redisLease.js"
      ],
      "review": [
        "docs/payments.md",
        "docs/operations.md",
        ".claude/rules/money-paths.md",
        "CLAUDE.md"
      ]
    },
    {
      "id": "catalog",
