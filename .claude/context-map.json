        "docs/payments.md",
        ".claude/rules/money-paths.md"
      ]
    },
    {
      "id": "admin-security",
      "impact": "high",
      "summary": "Admin auth, sessions, CSRF, authorization, audit log, admin API",
      "globs": [
        "services/admin/auth.js",
        "services/admin/authorization.js",
        "services/admin/audit.js",
