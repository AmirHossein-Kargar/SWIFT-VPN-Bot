# =============================================================================
# SWIFT-VPN-Bot — environment template
#
# Copy to `.env` for local development:   cp .env.example .env
# On Railway, set these as service Variables instead of shipping a file.
#
# Never commit a real `.env`. Every value below is a placeholder.
# =============================================================================

# ─── Telegram (REQUIRED) ─────────────────────────────────────────────────────
# Token from @BotFather. Format: 123456789:AA...  (validated by scripts/preflight.js)
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the admin panel.
# FAIL-CLOSED: if this is empty or unparsable, NOBODY is an admin.
ADMINS=

# The MAIN OWNER. Only the owner can add/remove other admins in the panel.
# Defaults to the FIRST entry of ADMINS when unset.
# OWNER_TELEGRAM_ID=

# How often (seconds) the bot reloads database-added admins. Default: 60.
# ADMIN_CACHE_TTL_SECONDS=60

# Admin group chat ID (negative, e.g. -1001234567890).
# When set, admin actions are only accepted from this chat.
GROUP_ID=

# Direct support contact shown to users (@username or numeric Telegram ID).
# Optional: when unset, users are offered the in-bot support chat only.
# Example: SUPPORT_CONTACT=@swift_support
SUPPORT_CONTACT=

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# MongoDB connection string. MongoDB is the authoritative store for all money.
#
# Accepted names (first match wins):
#   MONGO_URL · MONGODB_URI · MONGO_URI · (MongoDB-scheme) DATABASE_URL
#   or the discrete parts MONGOHOST + MONGOPORT + MONGOUSER + MONGOPASSWORD
#
# If the URI carries no database name, "/swiftvpn" is appended (override with
# MONGO_DB_NAME) so the target database is deterministic.
#
# Railway: MONGO_URL = ${{MongoDB.MONGO_URL}}
# Local development example only; replace with the Railway private MongoDB URL.
# MONGO_URL=mongodb://127.0.0.1:27017/swiftvpn
MONGO_URL=
# MONGO_DB_NAME=swiftvpn

# ─── Redis (REQUIRED in production) ──────────────────────────────────────────
# Used for sessions, in-flight locks and cron mutual exclusion.
# The app STARTS and keeps serving if Redis is down (fail-open for payments,
# fail-closed for cron), so these are only strictly required for full function.
#
# Accepted names (first match wins):
#   REDIS_URL                          (e.g. redis://default:pass@host:6379)
#   REDIS_HOST | REDISHOST             (+ port / username / password)
#
# Railway's native names are accepted directly — no renaming needed:
#   REDIS_URL        = ${{Redis.REDIS_URL}}
#   REDIS_HOST       = ${{Redis.REDISHOST}}
#   REDIS_PORT       = ${{Redis.REDISPORT}}
#   REDIS_USERNAME   = ${{Redis.REDISUSER}}
#   REDIS_PASSWORD   = ${{Redis.REDISPASSWORD}}
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 6+ ACL username. Most deployments use "default".
REDIS_USERNAME=default
# Leave empty when the server has no password.
REDIS_PASSWORD=

# ─── VPN panel / WizardXray (REQUIRED) ───────────────────────────────────────
# API v1 base URL WITHOUT the trailing slash; the method name (status, clients, create,
# find, delsv, change_link, upg_time, upg_size, reverse_mode) is appended by the client.
# Example: https://robot.wizardxray.shop/newbot/api/v1
WIZARD_API_URL=
# Bearer token for the panel API.
VPN_API_KEY=
# How long (seconds) live service status from the panel is cached per service.
# Default: 90 (min 15, max 600). Protects the panel from rapid menu browsing.
# WIZARD_STATUS_TTL_SECONDS=90

# ─── HooshPay — primary online gateway (REQUIRED) ────────────────────────────
HOOSHPAY_API_KEY=
# HMAC-SHA256 secret used to verify webhook signatures.
# MANDATORY: if unset, EVERY webhook is rejected (there is no bypass path).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HOOSHPAY_WEBHOOK_SECRET=
# Public HTTPS base URL of THIS server, no trailing slash.
# The gateway posts to: <WEBHOOK_BASE_URL>/api/hooshpay/webhook
# Railway example: https://your-app.up.railway.app
WEBHOOK_BASE_URL=

# ─── Bank card-to-card (OPTIONAL, legacy) ────────────────────────────────────
# 16-digit card number for the manual card-to-card flow. That flow is no longer
# offered in the top-up menu; the value is only validated if you set it.
CARD_NUMBER=

# ─── NOWPayments — TRON wallet top-up (REQUIRED) ─────────────────────────────
# Hosted invoice API: POST https://api.nowpayments.io/v1/invoice
# Authentication is the x-api-key header only. Do not put the key in Telegram,
# logs, or client-side code. NOWPAYMENTS_PUBLIC_KEY is not used by this flow
# and is not a substitute for the API key.
NOWPAYMENTS_API_KEY=
# HMAC-SHA512 secret from the NOWPayments dashboard:
# Payment Settings → Instant Payment Notifications.
NOWPAYMENTS_IPN_SECRET=
# Public HTTPS URL that receives IPNs. Must match the dashboard callback if you
# also set one there. Example:
# https://your-app.up.railway.app/api/nowpayments/ipn
NOWPAYMENTS_IPN_CALLBACK_URL=
# Live USDT/IRT quote comes from Gheymat. IRT is labeled Toman by that API.
# Do not set a static toman-per-dollar rate; a missing or stale quote stops
# invoice creation. Optional paid-plan token is sent only as x-api-token.
# GHEYMAT_API_TOKEN=
# GHEYMAT_CACHE_TTL_SECONDS=600
# GHEYMAT_MAX_QUOTE_AGE_SECONDS=900
# NOWPAYMENTS_PRICE_CURRENCY=usd
# NOWPAYMENTS_API_BASE_URL=https://api.nowpayments.io/v1
# NOWPAYMENTS_CATALOG_TTL_SECONDS=300
# Optional: narrow (never extend) the customer crypto choices defined in
# services/nowpayments/allowlist.js, e.g. NOWPAYMENTS_ENABLED_CURRENCIES=usdttrc20,trx
# NOWPAYMENTS_ENABLED_CURRENCIES=
# Only if the account auto-converts incoming coins to one payout coin (see docs/payments.md):
# NOWPAYMENTS_MIN_AMOUNT_CURRENCY_TO=
# Optional safety margin (percent, 0-100) on top of the provider minimum; 0 = off (see docs/payments.md):
# NOWPAYMENTS_MIN_AMOUNT_MARGIN_PERCENT=0
# NOWPAYMENTS_FIXED_RATE=false
# NOWPAYMENTS_FEE_PAID_BY_USER=false
# Optional NOWPayments Custody / Mass Payouts credentials (POST /v1/auth JWT):
# Required only when using Custody conversions, payouts, or provider payment listing in /admin.
# NOWPAYMENTS_EMAIL=
# NOWPAYMENTS_PASSWORD=

# ─── Direct TRX wallet (legacy flow; the address is still validated at startup) ─
# Tron address that receives direct TRX payments (starts with "T", 34 chars).
TRX_WALLET=
# CoinMarketCap key used to quote the TRX price. Without it a fixed fallback
# price (0.08 USD) is used, which will mis-price invoices. Recommended.
CMC_API_KEY=

# ─── Web Admin Dashboard (/panel) ───────────────────────────────────────────
# The dashboards ship inside the bot process — no extra service to deploy.
# Open https://<WEBHOOK_BASE_URL>/panel (/next-panel, /panel-next and /admin redirect there) and sign in with a
# Telegram ID from ADMINS; a one-time code is delivered by the bot as a direct
# message.
# Sessions are Redis-backed, HttpOnly-cookie based and CSRF-protected.

# Admin payment deletion: a still-pending/expired top-up record may only be deleted after this many hours (minimum 24,
# default 72). Rejected records are deletable at once; anything credited, paid or holding funds never is.
# ADMIN_PENDING_DELETE_MIN_HOURS=72

# Session lifetime in seconds (min 900, max 86400). Default: 28800 (8 hours).
# ADMIN_SESSION_TTL_SECONDS=28800

# ─── Public storefront (/) ───────────────────────────────────────────────────
# Telegram username of this bot (without @) used for the storefront checkout
# deep links (https://t.me/<name>?start=plan_<id>). Optional: when unset, the
# username reported by Telegram getMe() at startup is used.
# BOT_USERNAME=

# ─── Admin mock tests (🧪 تست ماک) ────────────────────────────────────────────
# Allows authorised admins to run the isolated mock-test harness from Telegram
# or /panel. Scenarios use in-memory data and simulated providers only: no real
# payment, wallet credit, blockchain transfer or VPN service is ever created.
# Disabled unless exactly "true". No request field can enable it.
# MOCK_TESTS_ENABLED=false


# ─── Optional tuning ─────────────────────────────────────────────────────────
# Express port. Railway injects PORT — do NOT hardcode it there.
# Locally it defaults to 3000.
PORT=3000

# Per-IP limit for the HooshPay webhook (requests per 60s window).
# 0 disables the limiter. Default: 600.
WEBHOOK_RATE_LIMIT_PER_MIN=600

# Server cost constants used by the admin profit reports (Toman).
COST_PER_DAY=200
COST_PER_GB=300

# ─── Test-only (npm test) ────────────────────────────────────────────────────
# MongoDB used by the DB-backed test suites. The database name MUST contain
# "test" — the helper refuses to run otherwise and each test file gets its own
# database. Never point this at production.
TEST_MONGO_URL=mongodb://127.0.0.1:27017/swiftvpn_test

# Wallet top-up limits in Toman (integers). Defaults: 10000 / 50000000.
# TOPUP_MIN_TOMAN=10000
# TOPUP_MAX_TOMAN=50000000
