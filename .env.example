# =============================================================================
# SWIFT-VPN-Bot — environment template
#
# Copy to `.env` for local development:   cp .env.example .env
# On Railway, set these as service Variables instead of shipping a file.
#
# Never commit a real `.env`. Every value below is a placeholder.
# =============================================================================

# ─── Telegram (REQUIRED) ─────────────────────────────────────────────────────
# Token from @BotFather. Format: 123456789:AA...  (validated by scripts/preflight.js)
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the admin panel.
# FAIL-CLOSED: if this is empty or unparsable, NOBODY is an admin.
ADMINS=

# Admin group chat ID (negative, e.g. -1001234567890).
# When set, admin actions are only accepted from this chat.
GROUP_ID=

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# MongoDB connection string. MongoDB is the authoritative store for all money.
# Railway: use the MongoDB plugin's MONGO_URL reference variable.
MONGO_URL=mongodb://127.0.0.1:27017/swiftvpn

# ─── Redis (REQUIRED in production) ──────────────────────────────────────────
# Used for sessions, in-flight locks and cron mutual exclusion.
# The app STARTS and keeps serving if Redis is down (fail-open for payments,
# fail-closed for cron), so these are only strictly required for full function.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 6+ ACL username. Most deployments use "default".
REDIS_USERNAME=default
# Leave empty when the server has no password.
REDIS_PASSWORD=

# ─── VPN panel / WizardXray (REQUIRED) ───────────────────────────────────────
# Base URL of the panel, no trailing slash. Example: https://panel.example.com
WIZARD_API_URL=
# Bearer token for the panel API.
VPN_API_KEY=

# ─── HooshPay — primary online gateway (REQUIRED) ────────────────────────────
HOOSHPAY_API_KEY=
# HMAC-SHA256 secret used to verify webhook signatures.
# MANDATORY: if unset, EVERY webhook is rejected (there is no bypass path).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HOOSHPAY_WEBHOOK_SECRET=
# Public HTTPS base URL of THIS server, no trailing slash.
# The gateway posts to: <WEBHOOK_BASE_URL>/api/hooshpay/webhook
# Railway example: https://your-app.up.railway.app
WEBHOOK_BASE_URL=

# ─── Bank card-to-card (REQUIRED if you offer bank payments) ─────────────────
# 16-digit card number shown to users.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CARD_NUMBER=

# ─── TRX crypto payments (REQUIRED if you offer TRX) ─────────────────────────
# Tron address that receives payments (starts with "T", 34 chars).
TRX_WALLET=
# CoinMarketCap key used to quote the TRX price. Without it a fixed fallback
# price (0.08 USD) is used, which will mis-price invoices. Recommended.
CMC_API_KEY=

# ─── Optional tuning ─────────────────────────────────────────────────────────
# Express port. Railway injects PORT — do NOT hardcode it there.
# Locally it defaults to 3000.
PORT=3000

# Per-IP limit for the HooshPay webhook (requests per 60s window).
# 0 disables the limiter. Default: 600.
WEBHOOK_RATE_LIMIT_PER_MIN=600

# Server cost constants used by the admin profit reports (Toman).
COST_PER_DAY=200
COST_PER_GB=300

# ─── Test-only (npm test) ────────────────────────────────────────────────────
# MongoDB used by the DB-backed test suites. The database name MUST contain
# "test" — the helper refuses to run otherwise and each test file gets its own
# database. Never point this at production.
TEST_MONGO_URL=mongodb://127.0.0.1:27017/swiftvpn_test
