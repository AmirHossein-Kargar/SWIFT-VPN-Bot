# ─── Telegram ────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
ADMINS=123456789,987654321          # comma-separated Telegram IDs of admins
GROUP_ID=-100123456789              # admin group chat ID (negative number)

# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/swiftvpn

# ─── Redis (session store) ───────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── VPN Panel API ───────────────────────────────────────────────────────────
WIZARD_API_URL=https://your-vpn-panel.example.com
VPN_API_KEY=your_vpn_panel_bearer_token

# ─── HooshPay (primary payment gateway) ─────────────────────────────────────
HOOSHPAY_API_KEY=your_hooshpay_api_key_here
# Secret used to verify incoming webhook HMAC-SHA256 signatures
HOOSHPAY_WEBHOOK_SECRET=your_hooshpay_webhook_secret_here
# Public base URL of this server (must be reachable by HooshPay)
# Example: https://bot.example.com  (no trailing slash)
WEBHOOK_BASE_URL=https://your-server.example.com

# ─── Bank card-to-card payment ───────────────────────────────────────────────
CARD_NUMBER=6219861234567890        # card number shown to users for bank transfers

# ─── TRX crypto payment ──────────────────────────────────────────────────────
TRX_WALLET=TYourTronWalletAddressHere
CMC_API_KEY=your_coinmarketcap_api_key

# ─── Profit calculation constants ────────────────────────────────────────────
COST_PER_DAY=200                    # server cost per day (Toman)
COST_PER_GB=300                     # server cost per GB (Toman)

# ─── Express server ──────────────────────────────────────────────────────────
PORT=3000

# ─── Legacy NowPayments (no longer used) ────────────────────────────────────
# NOW_PAYMENTS_API_KEY=your_nowpayments_key
