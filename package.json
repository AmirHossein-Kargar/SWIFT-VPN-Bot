{
  "name": "swift-vpn-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram VPN (VLESS) reseller bot with wallet, HooshPay/TRX/bank payments, WizardXray provisioning and an admin panel.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node bot.js",
    "preflight": "node scripts/preflight.js",
    "cleanup:legacy-phone-data": "node scripts/cleanupLegacyPhoneData.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "moment-jalaali": "^0.10.4",
    "mongoose": "^8.15.2",
    "node-telegram-bot-api": "^0.66.0",
    "redis": "^5.6.0"
  },
  "overrides": {
    "request": "npm:@cypress/request@3.0.10",
    "uuid": "11.1.1",
    "qs": "6.16.0",
    "form-data": "4.0.6",
    "tough-cookie": "5.1.2"
  }
}
